{
  "manifest_version": 3,
  "name": "Chrome Block",
  "version": "0.1.1",
  "description": "Frená las pestañas no deseadas en los sitios que vos elijas.",
  "minimum_chrome_version": "120",
  "permissions": ["activeTab", "storage", "scripting", "declarativeNetRequestWithHostAccess"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background/index.js", "type": "module" },
  "action": { "default_title": "Chrome Block", "default_popup": "popup/popup.html" },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
